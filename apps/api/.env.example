# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_NAME=Matti Stock API
APP_KEY=
APP_URL=http://${HOST}:${PORT}
WEB_URL=http://localhost:5173
HEALTH_CHECK_SECRET=

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# Database
#--------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5434
DB_USER=matti_stock_user
DB_PASSWORD=matti_stock_password
DB_DATABASE=matti_stock

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

#--------------------------------------------------------------------
# Queue
#--------------------------------------------------------------------
QUEUE_DRIVER=database

# Cross-process coordination
LOCK_STORE=database

# Transmit
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=

# Mail
MAIL_MAILER=smtp
MAIL_FROM_NAME=Matti Stock
MAIL_FROM_ADDRESS=stock@example.com
# Development uses the credentials shown by the Mailtrap Sandbox Integration tab.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=

# Private evidence storage. Use `fs` locally and `r2` in production.
DRIVE_DISK=fs
R2_KEY=
R2_SECRET=
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Login and recovery attempt state is durable outside tests.
LIMITER_STORE=database

# Supply these only while running the deployment Master Admin seeder.
BOOTSTRAP_INSTITUTE_NAME=
BOOTSTRAP_MASTER_NAME=
BOOTSTRAP_MASTER_EMAIL=
