# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=test

# App
LOG_LEVEL=silent
APP_NAME=MaTTI Stock API Tests
APP_KEY=
APP_URL=http://${HOST}:${PORT}
WEB_URL=http://localhost:5173
HEALTH_CHECK_SECRET=

# Session
SESSION_DRIVER=memory

# Database
DB_HOST=127.0.0.1
DB_PORT=5434
DB_USER=matti_stock_user
DB_PASSWORD=matti_stock_password
DB_DATABASE=matti_stock_test

# Queue
QUEUE_DRIVER=sync
LIMITER_STORE=memory

# Cross-process coordination
LOCK_STORE=database

# Transmit is process-local in tests, but the validated connection boundary
# remains explicit.
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=

# Mail
MAIL_MAILER=smtp
MAIL_FROM_NAME=MaTTI Stock Tests
MAIL_FROM_ADDRESS=stock-tests@example.com
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# Drive uses its private local disk in tests. The R2 values are deliberately
# inert but required because both configured disks are validated at boot.
DRIVE_DISK=fs
R2_KEY=unused-in-tests
R2_SECRET=unused-in-tests
R2_BUCKET=unused-in-tests
R2_ENDPOINT=http://127.0.0.1:9000
